{
  "name": "bodega-tony-tony",
  "version": "2.0.0",
  "description": "App de Bodega con gestión completa, rastreo en vivo y notificaciones push",
  "type": "module",
  "main": "index.html",
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "build": "node scripts/build.js",
    "dev": "http-server -c-1 -o",
    "optimize": "node scripts/optimize.js",
    "start": "http-server",
    "pretest": "npm run lint:fix",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "firebase": "^9.23.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.22.0",
    "@playwright/test": "^1.40.0",
    "@testing-library/dom": "^9.3.0",
    "@testing-library/jest-dom": "^6.1.4",
    "babel-jest": "^29.5.0",
    "eslint": "^8.45.0",
    "http-server": "^14.1.1",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "terser": "^5.18.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
