<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#1a1a2e">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Admin Tony Tony">
<title>⚙️ Admin - Bodega Tony Tony</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-firestore-compat.js"></script>
<style>
:root{--rojo:#e63946;--amarillo:#f4d35e;--verde:#2dc653;--oscuro:#1a1a2e;--sombra:0 4px 20px rgba(0,0,0,0.12);--bg:#f5f5f5;--card:#fff;--text:#1a1a2e;--subtext:#666;--border:#eee;--gris:#f1f1f1;}
.dark-mode{--bg:#0f0f1a;--card:#1a1a2e;--text:#f0f0f0;--subtext:#bbb;--border:#2a2a3e;--gris:#2a2a3e;}
*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:'Nunito',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;}
header{background:var(--oscuro);color:white;padding:16px 20px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100;box-shadow:0 2px 12px rgba(0,0,0,0.3);}
.logo{font-family:'Bebas Neue',sans-serif;font-size:22px;letter-spacing:2px;color:var(--amarillo);}
.logo span{color:var(--rojo);}
.tabs{display:flex;background:var(--card);border-bottom:3px solid var(--amarillo);overflow-x:auto;scrollbar-width:none;}
.tabs::-webkit-scrollbar{display:none;}
.tab-btn{padding:11px 14px;border:none;background:transparent;font-family:'Nunito',sans-serif;font-weight:700;font-size:13px;color:var(--subtext);cursor:pointer;white-space:nowrap;border-bottom:3px solid transparent;margin-bottom:-3px;transition:all 0.2s;}
.tab-btn.active{color:var(--rojo);border-bottom-color:var(--rojo);}
.view{display:none;padding:16px;}
.view.active{display:block;}
.admin-section{background:var(--card);border-radius:16px;padding:18px;box-shadow:var(--sombra);margin-bottom:16px;}
.admin-section h3{font-family:'Bebas Neue',sans-serif;font-size:20px;letter-spacing:1px;margin-bottom:14px;color:var(--text);border-left:4px solid var(--rojo);padding-left:10px;}
.form-row{display:flex;gap:10px;margin-bottom:10px;flex-wrap:wrap;}
.form-row input,.form-row select{flex:1;min-width:120px;padding:10px 14px;border:2px solid var(--border);border-radius:10px;font-family:'Nunito',sans-serif;font-size:14px;outline:none;transition:border 0.2s;background:var(--bg);color:var(--text);}
.form-row input:focus,.form-row select:focus{border-color:var(--rojo);}
.btn-primary{background:var(--rojo);color:white;border:none;border-radius:10px;padding:10px 20px;font-family:'Nunito',sans-serif;font-weight:800;font-size:14px;cursor:pointer;}
.btn-secondary{background:var(--oscuro);color:white;border:none;border-radius:10px;padding:10px 20px;font-family:'Nunito',sans-serif;font-weight:800;font-size:14px;cursor:pointer;}
.photo-upload-area{width:100%;height:100px;border:2px dashed #ddd;border-radius:12px;display:flex;flex-direction:column;align-items:center;justify-content:center;cursor:pointer;font-size:13px;font-weight:700;color:#999;gap:6px;overflow:hidden;margin-bottom:10px;}
.photo-upload-area img{width:100%;height:100%;object-fit:cover;}
.variants-input-area{margin-bottom:12px;}
.variants-input-area>label{font-size:13px;font-weight:700;display:block;margin-bottom:6px;color:var(--subtext);}
.variant-tags{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px;}
.variant-tag{background:var(--oscuro);color:white;border-radius:50px;padding:4px 10px;font-size:12px;font-weight:700;display:flex;align-items:center;gap:5px;}
.variant-tag button{background:none;border:none;color:white;cursor:pointer;font-size:16px;padding:0;line-height:1;}
.variant-add-row{display:flex;gap:8px;}
.variant-add-row input{flex:1;padding:8px 12px;border:2px solid var(--border);border-radius:10px;font-family:'Nunito',sans-serif;font-size:13px;outline:none;background:var(--bg);color:var(--text);}
.variant-add-row button{background:var(--oscuro);color:white;border:none;border-radius:10px;padding:8px 14px;font-weight:800;cursor:pointer;font-size:13px;white-space:nowrap;}
.product-list-admin{display:flex;flex-direction:column;gap:10px;}
.product-item-admin{display:flex;align-items:center;gap:10px;background:var(--gris);border-radius:12px;padding:10px 14px;}
.product-item-admin .thumb{width:44px;height:44px;border-radius:8px;object-fit:cover;flex-shrink:0;}
.product-item-admin .pemoji{font-size:28px;flex-shrink:0;}
.product-item-admin .info{flex:1;min-width:0;}
.product-item-admin .info .name{font-weight:700;font-size:14px;}
.product-item-admin .info .cat{font-size:12px;color:var(--subtext);}
.del-btn{background:none;border:none;font-size:20px;cursor:pointer;padding:4px;border-radius:8px;}
.del-btn:hover{background:#ffd6d6;}
.edit-btn{background:none;border:none;font-size:20px;cursor:pointer;padding:4px;border-radius:8px;}
.edit-btn:hover{background:#fff3cd;}
.pedido-card{background:var(--gris);border-radius:14px;padding:14px;margin-bottom:12px;}
.estado-badge{font-size:11px;font-weight:800;padding:4px 10px;border-radius:50px;white-space:nowrap;}
.estado-pendiente{background:#fff3cd;color:#856404;}
.estado-confirmado{background:#d4edda;color:#155724;}
.estado-preparacion{background:#cce5ff;color:#004085;}
.estado-camino{background:#ffe5d0;color:#c05621;}
.estado-entregado{background:#d4edda;color:#155724;}
.lock-screen{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px;background:var(--oscuro);}
.lock-card{background:#1e1e2e;border-radius:24px;padding:30px 24px;text-align:center;max-width:300px;width:100%;}
.pin-dot{width:16px;height:16px;border-radius:50%;border:2px solid #555;background:transparent;transition:background 0.15s;}
.pin-dot.filled{background:var(--rojo);border-color:var(--rojo);}
.pin-key{background:#2a2a3e;color:white;border:none;border-radius:14px;padding:18px;font-family:'Nunito',sans-serif;font-weight:800;font-size:20px;cursor:pointer;transition:background 0.15s,transform 0.1s;}
.pin-key:active{background:var(--rojo);transform:scale(0.92);}
.repartidor-item{display:flex;align-items:center;gap:10px;background:var(--gris);border-radius:12px;padding:10px 14px;margin-bottom:8px;}
.toggle-switch{position:relative;width:44px;height:24px;flex-shrink:0;}
.toggle-switch input{opacity:0;width:0;height:0;}
.toggle-slider{position:absolute;cursor:pointer;top:0;left:0;right:0;bottom:0;background:#ccc;border-radius:24px;transition:0.3s;}
.toggle-slider:before{position:absolute;content:"";height:18px;width:18px;left:3px;bottom:3px;background:white;border-radius:50%;transition:0.3s;}
input:checked+.toggle-slider{background:var(--verde);}
input:checked+.toggle-slider:before{transform:translateX(20px);}
.stat-card{background:var(--gris);border-radius:14px;padding:14px;text-align:center;position:relative;overflow:hidden;}
.stat-card::before{content:'';position:absolute;top:0;left:0;width:4px;height:100%;background:var(--stat-color,var(--rojo));}
.stat-val{font-family:'Bebas Neue',sans-serif;font-size:24px;letter-spacing:1px;}
.stat-lbl{font-size:11px;color:var(--subtext);font-weight:700;margin-top:2px;}
.pedido-meta{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:6px;}
.pedido-meta-chip{background:var(--card);border:1px solid var(--border);border-radius:50px;padding:2px 8px;font-size:11px;font-weight:700;color:var(--subtext);}
.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(80px);background:var(--oscuro);color:white;padding:12px 24px;border-radius:50px;font-weight:700;font-size:14px;z-index:999;transition:transform 0.3s cubic-bezier(0.34,1.56,0.64,1);white-space:nowrap;pointer-events:none;box-shadow:0 8px 24px rgba(0,0,0,0.3);}
.toast.show{transform:translateX(-50%) translateY(0);}
</style>
</head>
<body>

<div class="lock-screen" id="lockScreen">
  <div class="lock-card">
    <div style="font-size:50px;margin-bottom:12px;">🔐</div>
    <div style="font-family:'Bebas Neue',sans-serif;font-size:26px;letter-spacing:2px;margin-bottom:4px;color:white;">ADMIN</div>
    <div style="font-family:'Bebas Neue',sans-serif;font-size:16px;color:var(--rojo);letter-spacing:1px;margin-bottom:20px;">BODEGA TONY TONY</div>
    <div id="pinDisplay" style="display:flex;justify-content:center;gap:12px;margin-bottom:24px;">
      <div class="pin-dot" id="dot0"></div><div class="pin-dot" id="dot1"></div>
      <div class="pin-dot" id="dot2"></div><div class="pin-dot" id="dot3"></div>
      <div class="pin-dot" id="dot4"></div><div class="pin-dot" id="dot5"></div>
    </div>
    <p id="pinError" style="color:var(--rojo);font-size:13px;font-weight:700;margin-bottom:12px;min-height:20px;"></p>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px;max-width:240px;margin:0 auto;">
      <button class="pin-key" onclick="pinPress('1')">1</button>
      <button class="pin-key" onclick="pinPress('2')">2</button>
      <button class="pin-key" onclick="pinPress('3')">3</button>
      <button class="pin-key" onclick="pinPress('4')">4</button>
      <button class="pin-key" onclick="pinPress('5')">5</button>
      <button class="pin-key" onclick="pinPress('6')">6</button>
      <button class="pin-key" onclick="pinPress('7')">7</button>
      <button class="pin-key" onclick="pinPress('8')">8</button>
      <button class="pin-key" onclick="pinPress('9')">9</button>
      <button class="pin-key" onclick="pinClear()" style="background:#555;font-size:14px;">⌫</button>
      <button class="pin-key" onclick="pinPress('0')">0</button>
      <button class="pin-key" onclick="checkPin()" style="background:var(--rojo);">✓</button>
    </div>
  </div>
</div>

<div id="adminPanel" style="display:none;">
  <header>
    <div>
      <div class="logo">Admin <span>Tony</span> Tony</div>
      <div style="font-size:11px;color:#aaa;">Panel de Administración</div>
    </div>
    <div style="display:flex;gap:8px;align-items:center;">
      <button onclick="toggleDark()" id="darkBtn" style="background:none;border:none;font-size:22px;cursor:pointer;">🌙</button>
      <button onclick="lockPanel()" style="background:var(--rojo);color:white;border:none;border-radius:50px;padding:8px 14px;font-family:'Nunito',sans-serif;font-weight:800;font-size:13px;cursor:pointer;">🔒 Salir</button>
    </div>
  </header>
  <div class="tabs">
    <button class="tab-btn active" onclick="showAdminTab('productos')" id="tab-productos">📦 Productos</button>
    <button class="tab-btn" onclick="showAdminTab('pedidos')" id="tab-pedidos">📋 Pedidos</button>
    <button class="tab-btn" onclick="showAdminTab('repartidores')" id="tab-repartidores">🛵 Repartidores</button>
    <button class="tab-btn" onclick="showAdminTab('zonas')" id="tab-zonas">🗺️ Zonas</button>
    <button class="tab-btn" onclick="showAdminTab('cupones')" id="tab-cupones">🎟️ Cupones</button>
    <button class="tab-btn" onclick="showAdminTab('soporte')" id="tab-soporte">📞 Soporte</button>
    <button class="tab-btn" onclick="showAdminTab('config')" id="tab-config">⚙️ Config</button>
  </div>

  <div class="view active" id="view-productos"><!-- igual estructura --><div class="admin-section"><h3>➕ Agregar Producto</h3><label for="newPhoto" style="cursor:pointer;display:block;"><div class="photo-upload-area" id="photoPreview"><span>📸 Toca para agregar foto</span></div><input type="file" id="newPhoto" accept="image/*" style="display:none;" onchange="previewPhoto(this)"></label><div class="form-row"><input type="text" id="newEmoji" placeholder="Emoji 🍎" maxlength="4" style="max-width:80px;text-align:center;font-size:20px;"><input type="text" id="newName" placeholder="Nombre del producto"></div><div class="form-row"><input type="number" id="newPrice" placeholder="Precio ($)" min="0" step="0.01"><input type="text" id="newCategory" placeholder="Categoría"></div><div class="form-row"><select id="newEtiqueta"><option value="">Sin etiqueta</option><option value="popular">⭐ Popular</option><option value="recomendado">👍 Recomendado</option><option value="hoy">⏰ Oferta por hoy</option></select><select id="newTipo"><option value="normal">Normal</option><option value="combo">📦 Combo</option></select></div><div class="form-row"><label style="display:flex;align-items:center;gap:8px;flex:1;font-weight:700;font-size:14px;cursor:pointer;padding:10px;border:2px solid var(--border);border-radius:10px;"><input type="checkbox" id="newOferta">🔥 Es oferta</label><input type="number" id="newPrecioAnterior" placeholder="Precio anterior $" min="0" step="0.01" style="flex:1;"><label style="display:flex;align-items:center;gap:6px;flex:0.7;font-weight:700;font-size:13px;cursor:pointer;padding:10px;border:2px solid var(--border);border-radius:10px;"><input type="checkbox" id="newVisible" checked>👁️ Visible</label></div><div class="form-row"><label style="display:flex;align-items:center;gap:8px;flex:1;font-weight:700;font-size:13px;cursor:pointer;padding:10px;border:2px solid var(--border);border-radius:10px;"><input type="checkbox" id="newAgotado">❌ Agotado</label><input type="number" id="newStock" placeholder="Stock (opcional)" min="0" step="1" style="flex:1;"></div><div class="variants-input-area"><label>🎨 Variantes (opcional)</label><div class="variant-tags" id="variantTags"></div><div class="variant-add-row"><input type="text" id="variantInput" placeholder="ej: Cola, Uva..." onkeyup="if(event.key==='Enter')addVariantTag()"><button onclick="addVariantTag()">+ Agregar</button></div></div><button class="btn-primary" onclick="addProduct()" style="width:100%;">✅ Agregar Producto</button></div><div class="admin-section"><h3>📦 Mis Productos</h3><div style="margin-bottom:10px;"><input type="text" id="adminSearch" placeholder="🔍 Buscar producto..." oninput="onAdminSearch()"></div><div class="product-list-admin" id="adminProductList"></div></div></div>

  <div class="view" id="view-pedidos"><div id="pedidosStatsBar" style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:14px;"></div><div class="admin-section"><h3>📋 Pedidos</h3><div style="display:flex;gap:6px;margin-bottom:12px;flex-wrap:wrap;"><button onclick="filterPedidos('todos')" id="fp-todos" class="btn-primary" style="font-size:12px;padding:6px 12px;border-radius:50px;">Todos</button><button onclick="filterPedidos('pendiente')" id="fp-pendiente" style="background:var(--gris);border:none;border-radius:50px;padding:6px 12px;font-weight:700;font-size:12px;cursor:pointer;color:var(--text);">⏳ Pendientes</button><button onclick="filterPedidos('confirmado')" id="fp-confirmado" style="background:var(--gris);border:none;border-radius:50px;padding:6px 12px;font-weight:700;font-size:12px;cursor:pointer;color:var(--text);">✅ Confirmados</button><button onclick="filterPedidos('preparacion')" id="fp-preparacion" style="background:var(--gris);border:none;border-radius:50px;padding:6px 12px;font-weight:700;font-size:12px;cursor:pointer;color:var(--text);">🍳 Preparando</button><button onclick="filterPedidos('camino')" id="fp-camino" style="background:var(--gris);border:none;border-radius:50px;padding:6px 12px;font-weight:700;font-size:12px;cursor:pointer;color:var(--text);">🛵 En camino</button><button onclick="filterPedidos('entregado')" id="fp-entregado" style="background:var(--gris);border:none;border-radius:50px;padding:6px 12px;font-weight:700;font-size:12px;cursor:pointer;color:var(--text);">📦 Entregados</button></div><div id="pedidosList">Cargando...</div></div></div>

  <div class="view" id="view-repartidores"><div class="admin-section"><h3>➕ Agregar Repartidor</h3><div class="form-row"><input type="text" id="repNombre" placeholder="Nombre completo"><input type="tel" id="repTelefono" placeholder="Teléfono"></div><div class="form-row"><input type="text" id="repPlaca" placeholder="Placa"><input type="text" id="repVehiculo" placeholder="Tipo (moto, carro...)"></div><button class="btn-primary" onclick="addRepartidor()" style="width:100%;">✅ Agregar Repartidor</button></div><div class="admin-section"><h3>🛵 Repartidores</h3><div id="repartidoresList"></div></div></div>

  <div class="view" id="view-zonas"><div class="admin-section"><h3>➕ Agregar Zona</h3><div class="form-row"><input type="text" id="zonaNombre" placeholder="Nombre de la zona"><input type="number" id="zonaCosto" placeholder="Costo ($)" min="0" step="0.5"></div><button class="btn-primary" onclick="addZona()" style="width:100%;">✅ Agregar Zona</button></div><div class="admin-section"><h3>🗺️ Zonas de entrega</h3><div id="zonasList"></div></div></div>

  <div class="view" id="view-cupones"><div class="admin-section"><h3>➕ Crear Cupón</h3><div class="form-row"><input type="text" id="cuponCodigo" placeholder="Código (ej: TONY10)" style="text-transform:uppercase;"><select id="cuponTipo"><option value="porcentaje">% Porcentaje</option><option value="fijo">$ Monto fijo</option></select></div><div class="form-row"><input type="number" id="cuponDescuento" placeholder="Valor" min="1"><input type="date" id="cuponExpira"></div><button class="btn-primary" onclick="crearCupon()" style="width:100%;">✅ Crear Cupón</button></div><div class="admin-section"><h3>🎟️ Cupones activos</h3><div id="cuponesList">Cargando...</div></div></div>

  <div class="view" id="view-soporte"><div class="admin-section"><h3>📞 Soporte / Reclamos</h3><div style="display:flex;gap:6px;margin-bottom:12px;flex-wrap:wrap;"><button onclick="filterSoporte('todos')" id="fs-todos" class="btn-primary" style="font-size:12px;padding:6px 12px;border-radius:50px;">Todos</button><button onclick="filterSoporte('nuevo')" id="fs-nuevo" style="background:var(--gris);border:none;border-radius:50px;padding:6px 12px;font-weight:700;font-size:12px;cursor:pointer;color:var(--text);">🆕 Nuevos</button><button onclick="filterSoporte('en_revision')" id="fs-revision" style="background:var(--gris);border:none;border-radius:50px;padding:6px 12px;font-weight:700;font-size:12px;cursor:pointer;color:var(--text);">🔍 En revisión</button><button onclick="filterSoporte('resuelto')" id="fs-resuelto" style="background:var(--gris);border:none;border-radius:50px;padding:6px 12px;font-weight:700;font-size:12px;cursor:pointer;color:var(--text);">✅ Resueltos</button></div><div id="soporteList">Cargando...</div></div></div>

  <div class="view" id="view-config"><div class="admin-section"><h3>📱 Pago Móvil</h3><div class="form-row"><input type="text" id="pmBanco" placeholder="Banco"><input type="text" id="pmNombre" placeholder="Nombre"></div><div class="form-row"><input type="text" id="pmCedula" placeholder="Cédula"><input type="tel" id="pmTelefono" placeholder="Teléfono"></div><button class="btn-primary" onclick="savePagoMovil()" style="width:100%;">💾 Guardar</button></div><div class="admin-section"><h3>🏦 Transferencia</h3><div class="form-row"><input type="text" id="trBanco" placeholder="Banco"><input type="text" id="trNombre" placeholder="Nombre"></div><div class="form-row"><input type="text" id="trCuenta" placeholder="Número de cuenta"></div><button class="btn-primary" onclick="saveTransferencia()" style="width:100%;">💾 Guardar</button></div><div class="admin-section"><h3>📱 WhatsApp</h3><div class="form-row"><input type="tel" id="configWhatsapp" placeholder="+58424..."><button class="btn-primary" onclick="saveWhatsapp()">Guardar</button></div></div><div class="admin-section"><h3>⚙️ Configuración</h3><div id="metodosConfig"></div><label style="display:flex;align-items:center;gap:12px;font-weight:700;cursor:pointer;margin:12px 0;"><label class="toggle-switch"><input type="checkbox" id="envioGratis" onchange="saveEnvioGratis()"><span class="toggle-slider"></span></label>Domicilio siempre gratis</label><div class="form-row"><input type="number" id="configMontoEnvio" placeholder="Monto envío gratis" min="0" step="0.5"><button class="btn-primary" onclick="saveMontoEnvio()">Guardar</button></div><div class="form-row"><input type="number" id="configTiempo" placeholder="Tiempo preparación (min)" min="1" max="180"><button class="btn-primary" onclick="saveTiempo()">Guardar</button></div><div class="form-row"><input type="number" id="configPedidoMinimo" placeholder="Pedido mínimo $" min="0" step="0.5"><button class="btn-primary" onclick="savePedidoMinimo()">Guardar</button></div><div class="form-row"><input type="number" id="configApertura" placeholder="Apertura (0–23)" min="0" max="23"><input type="number" id="configCierre" placeholder="Cierre (0–23)" min="0" max="23"><button class="btn-primary" onclick="saveHorario()">Guardar</button></div></div><div class="admin-section"><h3>📊 Estadísticas</h3><div id="statsPanel" style="display:grid;grid-template-columns:1fr 1fr;gap:10px;"></div></div></div>
</div>

<div class="toast" id="toast"></div>

<script>
let darkMode = localStorage.getItem('darkMode') === '1';
function applyDark() { document.body.classList.toggle('dark-mode', darkMode); document.getElementById('darkBtn').textContent = darkMode ? '☀️' : '🌙'; }
function toggleDark() { darkMode = !darkMode; localStorage.setItem('darkMode', darkMode?'1':'0'); applyDark(); }
applyDark();

firebase.initializeApp({ apiKey:"AIzaSyBdv2cOMgbeBuW-V9Buz8EzGAoElnvySoI", authDomain:"bodegatonytony.firebaseapp.com", projectId:"bodegatonytony", storageBucket:"bodegatonytony.firebasestorage.app", messagingSenderId:"763208241886", appId:"1:763208241886:web:dd4a04d68c2c72ed24a84f" });
const db = firebase.firestore();

let products=[], currentVariants=[], pendingPhotoBase64='', pedidosFiltro='todos', soporteFiltro='todos', allPedidos=[], allSoporte=[], repartidores=[], zonas=[], allCupones=[], configData={ whatsapp:'+584242520138', metodosPago:{efectivo:true,pagoMovil:true,transferencia:false}, envioGratis:true, pedidoMinimo:0 };
let pinEntered='', adminPin='', unsubscribes=[], searchTimeout=null;

// ══════════════ PIN DESDE FIRESTORE ══════════════
async function loadAdminPin() {
  try {
    const snap = await db.collection('config').doc('seguridad').get();
    adminPin = snap.exists ? snap.data().adminPin : '300419'; // fallback solo desarrollo
  } catch(e) {
    adminPin = '300419';
    console.warn('Usando PIN por defecto. Crea /config/seguridad en Firestore');
  }
}
loadAdminPin();

function pinPress(digit) {
  if (pinEntered.length >= 6) return;
  pinEntered += digit; updatePinDots();
  if (pinEntered.length === 6) setTimeout(checkPin, 200);
}
function pinClear() { pinEntered = pinEntered.slice(0,-1); updatePinDots(); document.getElementById('pinError').textContent = ''; }
function updatePinDots() { for (let i=0;i<6;i++) { const d=document.getElementById('dot'+i); if(d)d.classList.toggle('filled',i<pinEntered.length); } }

async function checkPin() {
  if (!adminPin) { document.getElementById('pinError').textContent='⏳ Verificando...'; return; }
  if (pinEntered === adminPin) {
    document.getElementById('lockScreen').style.display='none';
    document.getElementById('adminPanel').style.display='block';
    pinEntered=''; updatePinDots(); initAdmin();
  } else {
    document.getElementById('pinError').textContent='❌ PIN incorrecto';
    pinEntered=''; updatePinDots();
    setTimeout(()=>{document.getElementById('pinError').textContent='';},2000);
  }
}
function lockPanel() {
  unsubscribes.forEach(fn=>fn()); unsubscribes=[];
  document.getElementById('lockScreen').style.display='flex';
  document.getElementById('adminPanel').style.display='none';
  pinEntered=''; updatePinDots(); document.getElementById('pinError').textContent='';
}

// ══════════════ INIT ══════════════
function initAdmin() {
  unsubscribes.forEach(fn=>fn()); unsubscribes=[];
  unsubscribes.push(db.collection('productos').onSnapshot(snap=>{products=snap.docs.map(d=>({id:d.id,...d.data()}));renderProductList();loadStats();}));
  unsubscribes.push(db.collection('pedidos').orderBy('fecha','desc').limit(200).onSnapshot(snap=>{allPedidos=snap.docs.map(d=>({id:d.id,...d.data()}));renderPedidos();loadStats();}));
  unsubscribes.push(db.collection('repartidores').onSnapshot(snap=>{repartidores=snap.docs.map(d=>({id:d.id,...d.data()}));renderRepartidores();}));
  unsubscribes.push(db.collection('zonas').onSnapshot(snap=>{zonas=snap.docs.map(d=>({id:d.id,...d.data()}));renderZonas();}));
  unsubscribes.push(db.collection('soporte').orderBy('fecha','desc').limit(100).onSnapshot(snap=>{allSoporte=snap.docs.map(d=>({id:d.id,...d.data()}));renderSoporteAdmin();}));
  unsubscribes.push(db.collection('cupones').orderBy('fecha','desc').onSnapshot(snap=>{allCupones=snap.docs.map(d=>({id:d.id,...d.data()}));renderCupones();}));
  unsubscribes.push(db.collection('config').doc('tienda').onSnapshot(snap=>{if(snap.exists){configData={...configData,...snap.data()};fillConfigFields();renderMetodosConfig();}}));
}

function fillConfigFields() {
  const el=id=>document.getElementById(id);
  if(el('configWhatsapp'))el('configWhatsapp').value=configData.whatsapp||'';
  if(el('envioGratis'))el('envioGratis').checked=configData.envioGratis!==false;
  if(el('configTiempo')&&configData.tiempoPreparacion)el('configTiempo').value=configData.tiempoPreparacion;
  if(el('configPedidoMinimo')&&configData.pedidoMinimo!=null)el('configPedidoMinimo').value=configData.pedidoMinimo;
  if(el('configMontoEnvio')&&configData.montoEnvioGratis!=null)el('configMontoEnvio').value=configData.montoEnvioGratis;
  if(configData.pagoMovil){const pm=configData.pagoMovil;if(el('pmBanco'))el('pmBanco').value=pm.banco||'';if(el('pmNombre'))el('pmNombre').value=pm.nombre||'';if(el('pmCedula'))el('pmCedula').value=pm.cedula||'';if(el('pmTelefono'))el('pmTelefono').value=pm.telefono||'';}
  if(configData.transferencia){const tr=configData.transferencia;if(el('trBanco'))el('trBanco').value=tr.banco||'';if(el('trNombre'))el('trNombre').value=tr.nombre||'';if(el('trCuenta'))el('trCuenta').value=tr.cuenta||'';}
  if(configData.horario){const h=configData.horario;if(el('configApertura'))el('configApertura').value=h.apertura;if(el('configCierre'))el('configCierre').value=h.cierre;}
}

// ══════════════ TABS ══════════════
function showAdminTab(tab){
  document.querySelectorAll('.view').forEach(v=>v.classList.remove('active'));
  document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));
  document.getElementById('view-'+tab).classList.add('active');
  document.getElementById('tab-'+tab).classList.add('active');
  if(tab==='config'){renderMetodosConfig();loadStats();}
  if(tab==='pedidos')loadStats();
}
function onAdminSearch(){clearTimeout(searchTimeout);searchTimeout=setTimeout(renderProductList,250);}

// ══════════════ PRODUCTOS ══════════════
function previewPhoto(input){const file=input.files[0];if(!file)return;const reader=new FileReader();reader.onload=e=>{const img=new Image();img.onload=()=>{const canvas=document.createElement('canvas');const MAX=400;let w=img.width,h=img.height;if(w>h){if(w>MAX){h=h*MAX/w;w=MAX;}}else{if(h>MAX){w=w*MAX/h;h=MAX;}}canvas.width=w;canvas.height=h;canvas.getContext('2d').drawImage(img,0,0,w,h);pendingPhotoBase64=canvas.toDataURL('image/jpeg',0.7);const prev=document.getElementById('photoPreview');prev.innerHTML=`<img src="${pendingPhotoBase64}">`;prev.style.border='none';};img.src=e.target.result;};reader.readAsDataURL(file);}
function addVariantTag(){const input=document.getElementById('variantInput');const val=input.value.trim();if(!val||currentVariants.includes(val))return;currentVariants.push(val);renderVariantTags();input.value='';}
function removeVariantTag(v){currentVariants=currentVariants.filter(x=>x!==v);renderVariantTags();}
function renderVariantTags(){document.getElementById('variantTags').innerHTML=currentVariants.map(v=>`<div class="variant-tag">${v}<button onclick="removeVariantTag('${v}')">×</button></div>`).join('');}

async function addProduct(){
  const emoji=document.getElementById('newEmoji').value.trim()||'📦';
  const name=document.getElementById('newName').value.trim();
  const price=parseFloat(document.getElementById('newPrice').value);
  const category=document.getElementById('newCategory').value.trim()||'General';
  const etiqueta=document.getElementById('newEtiqueta').value||'';
  const tipo=document.getElementById('newTipo').value||'normal';
  const oferta=document.getElementById('newOferta').checked||false;
  const precioAnterior=parseFloat(document.getElementById('newPrecioAnterior').value)||0;
  const visible=document.getElementById('newVisible').checked!==false;
  const agotado=document.getElementById('newAgotado').checked||false;
  const stockVal=document.getElementById('newStock').value;
  const stock=stockVal!==''?parseInt(stockVal):null;
  if(!name){showToast('⚠️ Escribe el nombre');return;}
  if(isNaN(price)||price<=0){showToast('⚠️ Precio inválido');return;}
  showToast('⏳ Guardando...');
  await db.collection('productos').add({emoji,name,price,category,photo:pendingPhotoBase64,variants:currentVariants,etiqueta,tipo,oferta,precioAnterior:oferta&&precioAnterior?precioAnterior:0,visible,agotado,stock});
  ['newEmoji','newName','newPrice','newCategory','newPrecioAnterior','newStock'].forEach(id=>{document.getElementById(id).value='';});
  document.getElementById('newEtiqueta').value='';document.getElementById('newOferta').checked=false;
  document.getElementById('newVisible').checked=true;document.getElementById('newAgotado').checked=false;
  document.getElementById('newPhoto').value='';document.getElementById('photoPreview').innerHTML='<span>📸 Toca para agregar foto</span>';
  pendingPhotoBase64='';currentVariants=[];renderVariantTags();showToast('✅ Producto agregado');
}
async function deleteProduct(id){if(!confirm('¿Eliminar este producto?'))return;await db.collection('productos').doc(id).delete();showToast('🗑️ Eliminado');}
async function toggleVisible(id,currentlyVisible){await db.collection('productos').doc(id).update({visible:!currentlyVisible});showToast(!currentlyVisible?'👁️ Visible':'🙈 Oculto');}
async function toggleAgotado(id,currentlyAgotado){await db.collection('productos').doc(id).update({agotado:!currentlyAgotado});showToast(!currentlyAgotado?'❌ Agotado':'✅ Disponible');}

function renderProductList(){
  const list=document.getElementById('adminProductList');if(!list)return;
  const q=(document.getElementById('adminSearch')?.value||'').toLowerCase();
  const filtered=q?products.filter(p=>p.name.toLowerCase().includes(q)||(p.category||'').toLowerCase().includes(q)):products;
  if(!filtered.length){list.innerHTML='<p style="color:var(--subtext);text-align:center;padding:20px;">No hay productos</p>';return;}
  list.innerHTML=filtered.map(p=>`<div class="product-item-admin">${p.photo?`<img src="${p.photo}" class="thumb">`:`<div class="pemoji">${p.emoji||'📦'}</div>`}<div class="info"><div class="name">${p.name}${p.agotado?' <span style="font-size:11px;color:#e63946;">❌ Agotado</span>':''}</div><div class="cat">${p.category||'General'} — $ ${p.price}${p.oferta?' 🔥':''}</div></div><button onclick="toggleAgotado('${p.id}',${!!p.agotado})" style="background:none;border:none;font-size:18px;cursor:pointer;">${p.agotado?'🔴':'🟢'}</button><button onclick="editarStock('${p.id}',${p.stock??'null'})" style="background:none;border:none;font-size:16px;cursor:pointer;">📦${p.stock!=null?'<span style=\'font-size:10px;font-weight:700;\'>'+p.stock+'</span>':''}</button><button onclick="toggleVisible('${p.id}',${p.visible!==false})" style="background:none;border:none;font-size:18px;cursor:pointer;">${p.visible!==false?'👁️':'🙈'}</button><button class="edit-btn" onclick="openEditModal('${p.id}')">✏️</button><button class="del-btn" onclick="deleteProduct('${p.id}')">🗑️</button></div>`).join('');
}

// ══════════════ PEDIDOS ══════════════
function filterPedidos(estado){pedidosFiltro=estado;renderPedidos();}
function renderPedidos(){
  const el=document.getElementById('pedidosList');if(!el)return;
  const filtered=pedidosFiltro==='todos'?allPedidos:allPedidos.filter(p=>p.estado===pedidosFiltro);
  if(!filtered.length){el.innerHTML='<p style="color:var(--subtext);text-align:center;padding:20px;">No hay pedidos</p>';return;}
  el.innerHTML=filtered.map(p=>`<div class="pedido-card"><div style="display:flex;justify-content:space-between;"><div><strong>👤 ${p.nombre}</strong></div><span class="estado-badge estado-${p.estado||'pendiente'}">${p.estado||'pendiente'}</span></div><div class="pedido-meta"><span class="pedido-meta-chip">📞 ${p.telefono}</span><span class="pedido-meta-chip">💳 ${p.metodoPago||'—'}</span></div><div style="font-size:13px;margin:6px 0;white-space:pre-line;">${p.productos}</div><div style="font-family:'Bebas Neue',sans-serif;font-size:24px;color:var(--rojo);">$ ${p.total?.toFixed(2)||'0.00'}</div><div style="display:flex;gap:5px;flex-wrap:wrap;margin-top:8px;"><button onclick="updateEstado('${p.id}','confirmado')" class="btn-primary" style="font-size:11px;padding:6px 10px;">✅ Confirmar</button><button onclick="updateEstado('${p.id}','preparacion')" class="btn-primary" style="font-size:11px;padding:6px 10px;">🍳 Preparando</button><button onclick="updateEstado('${p.id}','camino')" class="btn-primary" style="font-size:11px;padding:6px 10px;">🛵 En camino</button><button onclick="updateEstado('${p.id}','entregado')" class="btn-primary" style="font-size:11px;padding:6px 10px;">📦 Entregado</button></div></div>`).join('');
}
async function updateEstado(id,estado){await db.collection('pedidos').doc(id).update({estado});showToast('✅ Estado actualizado');}

// ══════════════ REPARTIDORES ══════════════
async function addRepartidor(){const nombre=document.getElementById('repNombre').value.trim();const telefono=document.getElementById('repTelefono').value.trim();const placa=document.getElementById('repPlaca').value.trim();const vehiculo=document.getElementById('repVehiculo').value.trim();if(!nombre||!telefono){showToast('⚠️ Nombre y teléfono requeridos');return;}await db.collection('repartidores').add({nombre,telefono,placa,vehiculo,activo:true});['repNombre','repTelefono','repPlaca','repVehiculo'].forEach(id=>{document.getElementById(id).value='';});showToast('✅ Repartidor agregado');}
async function deleteRepartidor(id){if(!confirm('¿Eliminar?'))return;await db.collection('repartidores').doc(id).delete();showToast('🗑️ Eliminado');}
function renderRepartidores(){const el=document.getElementById('repartidoresList');if(!el)return;if(!repartidores.length){el.innerHTML='<p style="color:var(--subtext);text-align:center;">No hay repartidores</p>';return;}el.innerHTML=repartidores.map(r=>`<div class="repartidor-item"><div style="font-size:28px;">🛵</div><div style="flex:1;"><div style="font-weight:700;">${r.nombre}</div><div style="font-size:12px;color:var(--subtext);">📞 ${r.telefono}</div></div><button onclick="deleteRepartidor('${r.id}')" class="del-btn">🗑️</button></div>`).join('');}

// ══════════════ ZONAS ══════════════
async function addZona(){const nombre=document.getElementById('zonaNombre').value.trim();const costo=parseFloat(document.getElementById('zonaCosto').value)||0;if(!nombre){showToast('⚠️ Escribe el nombre');return;}await db.collection('zonas').add({nombre,costo});document.getElementById('zonaNombre').value='';document.getElementById('zonaCosto').value='';showToast('✅ Zona agregada');}
async function deleteZona(id){if(!confirm('¿Eliminar?'))return;await db.collection('zonas').doc(id).delete();showToast('🗑️ Eliminada');}
function renderZonas(){const el=document.getElementById('zonasList');if(!el)return;if(!zonas.length){el.innerHTML='<p style="color:var(--subtext);text-align:center;">No hay zonas</p>';return;}el.innerHTML=zonas.map(z=>`<div style="display:flex;align-items:center;gap:10px;background:var(--gris);border-radius:12px;padding:10px 14px;margin-bottom:8px;"><div style="font-size:24px;">📍</div><div style="flex:1;"><div style="font-weight:700;">${z.nombre}</div><div style="font-size:12px;color:var(--subtext);">Costo: ${z.costo>0?'$'+z.costo:'Gratis'}</div></div><button onclick="deleteZona('${z.id}')" class="del-btn">🗑️</button></div>`).join('');}

// ══════════════ CUPONES ══════════════
async function crearCupon(){const codigo=document.getElementById('cuponCodigo').value.trim().toUpperCase();const tipo=document.getElementById('cuponTipo').value;const descuento=parseFloat(document.getElementById('cuponDescuento').value);const expira=document.getElementById('cuponExpira').value;if(!codigo){showToast('⚠️ Escribe un código');return;}if(isNaN(descuento)||descuento<=0){showToast('⚠️ Ingresa el valor');return;}await db.collection('cupones').add({codigo,tipo,descuento,expira:expira||null,activo:true,fecha:new Date().toISOString(),usos:0});['cuponCodigo','cuponDescuento','cuponExpira'].forEach(id=>{document.getElementById(id).value='';});showToast('✅ Cupón creado');}
async function toggleCupon(id,activo){await db.collection('cupones').doc(id).update({activo:!activo});showToast(!activo?'✅ Activado':'❌ Desactivado');}
async function deleteCupon(id){if(!confirm('¿Eliminar?'))return;await db.collection('cupones').doc(id).delete();showToast('🗑️ Eliminado');}
function renderCupones(){const el=document.getElementById('cuponesList');if(!el)return;if(!allCupones.length){el.innerHTML='<p style="color:var(--subtext);text-align:center;">No hay cupones</p>';return;}el.innerHTML=allCupones.map(c=>`<div style="background:var(--gris);border-radius:12px;padding:12px 14px;margin-bottom:8px;display:flex;align-items:center;gap:10px;"><div style="flex:1;"><div style="font-weight:800;color:${c.activo?'var(--verde)':'var(--subtext)'};">🎟️ ${c.codigo}</div><div style="font-size:12px;color:var(--subtext);">${c.tipo==='porcentaje'?c.descuento+'%':'$'+c.descuento} · ${c.usos||0} usos</div></div><button onclick="toggleCupon('${c.id}',${c.activo})" style="background:${c.activo?'#2dc653':'#aaa'};color:white;border:none;border-radius:8px;padding:6px 10px;font-size:12px;font-weight:700;cursor:pointer;">${c.activo?'ON':'OFF'}</button><button onclick="deleteCupon('${c.id}')" class="del-btn">🗑️</button></div>`).join('');}

// ══════════════ SOPORTE ══════════════
function filterSoporte(estado){soporteFiltro=estado;renderSoporteAdmin();}
function renderSoporteAdmin(){const el=document.getElementById('soporteList');if(!el)return;const filtered=soporteFiltro==='todos'?allSoporte:allSoporte.filter(s=>s.estado===soporteFiltro);if(!filtered.length){el.innerHTML='<p style="color:var(--subtext);text-align:center;">No hay reportes</p>';return;}el.innerHTML=filtered.map(s=>`<div class="pedido-card"><div style="display:flex;justify-content:space-between;"><div style="font-weight:800;">👤 ${s.clienteNombre}</div><span class="estado-badge ${s.estado==='resuelto'?'estado-entregado':'estado-pendiente'}">${s.estado}</span></div><div style="font-size:13px;font-weight:700;color:var(--rojo);">⚠️ ${s.tipoProblema}</div><div style="font-size:13px;">${s.descripcion}</div><div style="display:flex;gap:6px;margin-top:8px;"><button onclick="updateSoporte('${s.id}','en_revision')" class="btn-primary" style="font-size:11px;padding:6px 10px;">🔍 En revisión</button><button onclick="updateSoporte('${s.id}','resuelto')" class="btn-primary" style="font-size:11px;padding:6px 10px;">✅ Resuelto</button></div></div>`).join('');}
async function updateSoporte(id,estado){await db.collection('soporte').doc(id).update({estado});showToast('✅ Actualizado');}

// ══════════════ CONFIG ══════════════
async function savePagoMovil(){const banco=document.getElementById('pmBanco').value.trim();const nombre=document.getElementById('pmNombre').value.trim();const cedula=document.getElementById('pmCedula').value.trim();const telefono=document.getElementById('pmTelefono').value.trim();if(!banco||!nombre||!telefono){showToast('⚠️ Completa los campos');return;}await db.collection('config').doc('tienda').set({pagoMovil:{banco,nombre,cedula,telefono}},{merge:true});showToast('✅ Guardado');}
async function saveTransferencia(){const banco=document.getElementById('trBanco').value.trim();const nombre=document.getElementById('trNombre').value.trim();const cuenta=document.getElementById('trCuenta').value.trim();if(!banco||!nombre){showToast('⚠️ Completa banco y nombre');return;}await db.collection('config').doc('tienda').set({transferencia:{banco,nombre,cuenta}},{merge:true});showToast('✅ Guardado');}
async function saveWhatsapp(){const wa=document.getElementById('configWhatsapp').value.trim();if(!wa){showToast('⚠️ Escribe el número');return;}await db.collection('config').doc('tienda').set({whatsapp:wa},{merge:true});showToast('✅ WhatsApp: '+wa);}
async function saveEnvioGratis(){const val=document.getElementById('envioGratis').checked;await db.collection('config').doc('tienda').set({envioGratis:val},{merge:true});showToast(val?'✅ Activado':'❌ Desactivado');}
async function saveTiempo(){const val=parseInt(document.getElementById('configTiempo').value);if(isNaN(val)||val<1){showToast('⚠️ Ingresa un tiempo válido');return;}await db.collection('config').doc('tienda').set({tiempoPreparacion:val},{merge:true});showToast('✅ Guardado');}
async function savePedidoMinimo(){const val=parseFloat(document.getElementById('configPedidoMinimo').value);if(isNaN(val)||val<0){showToast('⚠️ Ingresa un monto válido');return;}await db.collection('config').doc('tienda').set({pedidoMinimo:val},{merge:true});showToast('✅ Guardado');}
async function saveMontoEnvio(){const val=parseFloat(document.getElementById('configMontoEnvio').value)||0;await db.collection('config').doc('tienda').set({montoEnvioGratis:val},{merge:true});showToast('✅ Guardado');}
async function saveHorario(){const apertura=parseInt(document.getElementById('configApertura').value);const cierre=parseInt(document.getElementById('configCierre').value);if(isNaN(apertura)||isNaN(cierre)){showToast('⚠️ Ingresa apertura y cierre');return;}await db.collection('config').doc('tienda').set({horario:{apertura,cierre}},{merge:true});showToast('✅ Horario actualizado');}
async function toggleMetodo(metodo,valor){const metodosPago={...configData.metodosPago,[metodo]:valor};await db.collection('config').doc('tienda').set({metodosPago},{merge:true});showToast('✅ Métodos actualizados');}
function renderMetodosConfig(){const el=document.getElementById('metodosConfig');if(!el)return;const labels={efectivo:'💵 Efectivo',pagoMovil:'📱 Pago Móvil',transferencia:'🏦 Transferencia'};el.innerHTML=Object.entries(labels).map(([k,label])=>`<div style="display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--border);"><span style="font-weight:700;">${label}</span><label class="toggle-switch"><input type="checkbox" ${configData.metodosPago[k]?'checked':''} onchange="toggleMetodo('${k}',this.checked)"><span class="toggle-slider"></span></label></div>`).join('');}

async function editarStock(id,stockActual){const nuevo=prompt(`Stock actual: ${stockActual??'sin límite'}\nNuevo stock (vacío = sin límite):`,stockActual??'');if(nuevo===null)return;const val=nuevo.trim()===''?null:parseInt(nuevo);if(nuevo.trim()!==''&&isNaN(val)){showToast('⚠️ Ingresa un número válido');return;}await db.collection('productos').doc(id).update({stock:val});showToast(val!==null?`✅ Stock: ${val} unidades`:'✅ Sin límite');}

function loadStats(){
  const hoy=new Date().toDateString();
  const pedidosHoy=allPedidos.filter(p=>new Date(p.fecha).toDateString()===hoy);
  const entregadosHoy=pedidosHoy.filter(p=>p.estado==='entregado');
  const ventasHoy=entregadosHoy.reduce((s,p)=>s+(p.total||0),0);
  const pendientes=allPedidos.filter(p=>p.estado==='pendiente').length;
  const enCamino=allPedidos.filter(p=>['camino','en_camino'].includes(p.estado)).length;
  const ingresoTotal=allPedidos.filter(p=>p.estado==='entregado').reduce((s,p)=>s+(p.total||0),0);
  const totalEntregados=allPedidos.filter(p=>p.estado==='entregado').length;
  const ticketPromedio=totalEntregados>0?ingresoTotal/totalEntregados:0;
  const el=document.getElementById('statsPanel');if(!el)return;
  el.innerHTML=[['📅','Pedidos hoy',pedidosHoy.length,'#ff6b2b'],['💵','Ventas hoy','$'+ventasHoy.toFixed(2),'#2dc653'],['⏳','Pendientes',pendientes,'#f4d35e'],['💰','Total ingresado','$'+ingresoTotal.toFixed(2),'#e63946'],['🧾','Ticket promedio','$'+ticketPromedio.toFixed(2),'#7b2ff7']].map(([emoji,label,val,color])=>`<div class="stat-card" style="--stat-color:${color};"><div style="font-size:22px;">${emoji}</div><div class="stat-val" style="color:${color};">${val}</div><div class="stat-lbl">${label}</div></div>`).join('');
  const pBar=document.getElementById('pedidosStatsBar');if(!pBar)return;
  pBar.innerHTML=[['⏳',pendientes,'#856404','#fff3cd','Pendientes'],['🍳',allPedidos.filter(p=>['preparacion','preparando'].includes(p.estado)).length,'#004085','#cce5ff','Preparando'],['🛵',enCamino,'#c05621','#ffe5d0','En camino'],['📦',entregadosHoy.length,'#155724','#d4edda','Entregados hoy']].map(([e,n,color,bg,lbl])=>`<div style="background:${bg};border-radius:12px;padding:10px 8px;text-align:center;"><div style="font-size:18px;">${e}</div><div style="font-family:'Bebas Neue',sans-serif;font-size:20px;color:${color};">${n}</div><div style="font-size:10px;color:${color};font-weight:700;">${lbl}</div></div>`).join('');
}

function showToast(msg){const t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),2500);}

// Edición de producto (simplificada)
let editingVariants=[],editingPhotoBase64='';
function openEditModal(id){const p=products.find(x=>x.id===id);if(!p)return;editingVariants=[...(p.variants||[])];const modal=document.createElement('div');modal.style.cssText='position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:999;display:flex;align-items:flex-end;';modal.innerHTML=`<div style="background:var(--card);border-radius:24px 24px 0 0;padding:20px;width:100%;max-height:90vh;overflow-y:auto;"><div style="font-family:'Bebas Neue',sans-serif;font-size:24px;margin-bottom:16px;">✏️ Editar</div><div style="display:flex;gap:10px;margin-bottom:10px;"><input type="text" id="editName" value="${p.name}" style="flex:1;padding:10px;border:2px solid var(--border);border-radius:10px;background:var(--bg);color:var(--text);"><input type="number" id="editPrice" value="${p.price}" style="flex:1;padding:10px;border:2px solid var(--border);border-radius:10px;background:var(--bg);color:var(--text);"></div><div style="display:flex;gap:10px;"><button onclick="this.parentElement.parentElement.parentElement.remove()" style="flex:1;padding:12px;border:2px solid var(--border);border-radius:12px;font-weight:800;cursor:pointer;background:var(--card);color:var(--text);">Cancelar</button><button onclick="saveEdit('${id}')" style="flex:2;padding:12px;background:var(--rojo);color:white;border:none;border-radius:12px;font-weight:800;cursor:pointer;">✅ Guardar</button></div></div>`;modal.onclick=e=>{if(e.target===modal)modal.remove();};document.body.appendChild(modal);}
async function saveEdit(id){const name=document.getElementById('editName')?.value.trim();const price=parseFloat(document.getElementById('editPrice')?.value);if(!name||isNaN(price)||price<=0){showToast('⚠️ Datos inválidos');return;}await db.collection('productos').doc(id).update({name,price,variants:editingVariants,photo:editingPhotoBase64||undefined});editingPhotoBase64='';document.querySelector('#adminPanel [style*="z-index:999"]')?.remove();showToast('✅ Actualizado');}
</script>
</body>
</html>
